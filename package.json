{
  "name": "torob-tickets",
  "version": "1.0.0",
  "private": true,
  "description": "Torob Tickets — AI-powered flight price aggregation and comparison (Persian, RTL)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate && node scripts/ensure-prisma-marker.mjs",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:history": "tsx scripts/db-history.ts",
    "db:doctor": "tsx scripts/db-doctor.ts",
    "db:validate": "prisma validate",
    "crawl": "tsx scripts/crawl.ts",
    "crawl:probe": "tsx scripts/crawl-probe.ts",
    "crawl:capture": "tsx scripts/crawl-capture.ts"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "cheerio": "^1.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.10",
    "lucide-react": "^0.545.0",
    "motion": "^14.13.0",
    "next": "^15.5.29",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.5.29",
    "jsdom": "^26.1.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }

# Torob Tickets — environment
#
# The site serves no demo ticket offers. Search reads only real Safarmarket
# snapshots stored under data/crawl; without a snapshot, results are empty.

# Optional: LLM intent understanding / refined explanations. The deterministic
# Persian parser and template explanations work without a key; ungrounded model
# output is discarded.
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# PostgreSQL is required for the continuous crawler and durable hourly history.
# Search can still read existing local snapshots without a DB.
#   CREATE DATABASE torob_tickets;
#   $env:DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/torob_tickets?schema=public"
#   npm run db:generate ; npm run db:push
# Prisma 7 reads this from prisma.config.ts and the @prisma/adapter-pg runtime.
# DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/torob_tickets?schema=public"
# TOROB_DB_MODE=off forces database history off (useful in tests).

# Read-only diagnostics:
#   npm run db:doctor
#   npm run db:history -- THR MHD 2026-11-20
# Remove old seeded demo records only:
#   $env:CLEAR_DEMO_SEED="1"; npm run db:clear-demo-seed; Remove-Item Env:CLEAR_DEMO_SEED

# Explicitly opt in to the separate Safarmarket worker; it is never started by
# a page visit. Follow docs/CRAWLER.md and use operator-verified route pairs.
# CRAWLER_ENABLED=1
# CRAWLER_ROUTES=THR-MHD,MHD-THR
# CRAWLER_INTERVAL_MINUTES=60
# CRAWLER_HORIZON_DAYS=1
# Minimum delay per Safarmarket host request, including robots.txt; 3,000–60,000 ms, default 10,000.
# CRAWLER_REQUEST_DELAY_MS=10000

# Optional e2e target (defaults to http://127.0.0.1:3100)
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

# ————————————————————————————————————————————————
# Torob Tickets — environment
#
# NOTHING here is required to run the demo.
# `npm install && npm run dev` works with an empty environment: all offers come
# from the curated demo dataset and all explanations are generated deterministically.
# ————————————————————————————————————————————————

# Optional: enables LLM intent understanding and LLM-refined explanations.
# The deterministic Persian parser + template explanations are used when absent,
# and any model output that fails Zod validation or the grounding check is discarded.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional: persistence for offer snapshots / search logs (Prisma + local Postgres).
# No Docker needed — a normal Windows Postgres install works.
# Create the database first:  CREATE DATABASE torob_tickets;
# Then (PowerShell):  $env:DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/torob_tickets?schema=public"
# and run:  npm run db:generate ; npm run db:push ; npm run db:seed
#
# The app runs fully in-memory when this is unset (and a broken DB never breaks a page).
# DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/torob_tickets?schema=public"

# Optional: e2e target (defaults to http://127.0.0.1:3100)
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

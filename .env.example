# ————————————————————————————————————————————————
# Torob Tickets — environment
#
# NOTHING here is required to run the demo.
# `npm install && npm run dev` works with an empty environment: all offers come
# from the curated demo dataset and all explanations are generated deterministically.
# ————————————————————————————————————————————————

# Optional: enables LLM intent understanding and LLM-refined explanations.
# The deterministic Persian parser + template explanations are used when absent,
# and any model output that fails Zod validation or the grounding check is discarded.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional: persistence for offer snapshots / search logs (Prisma + local Postgres).
# No Docker needed — a normal Windows Postgres install works.
# Create the database first:  CREATE DATABASE torob_tickets;
# Then (PowerShell):  $env:DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/torob_tickets?schema=public"
# and run:  npm run db:generate ; npm run db:push ; npm run db:seed
#
# The app runs fully in-memory when this is unset (and a broken DB never breaks a page).
# DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/torob_tickets?schema=public"

# Optional: e2e target (defaults to http://127.0.0.1:3100)
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

# ————————————————————————————————————————————————
# Live aggregation (real providers)
#
# The demo remains the default. Nothing below is needed to run `npm run dev`;
# set these only when you want real data from real sources.
# ————————————————————————————————————————————————

# demo (default) → curated sample data, clearly badged in the UI.
# live            → queries the providers below.
# TOROB_SEARCH_MODE=demo

# ——— PostgreSQL (REQUIRED for the live path: price history) ———
# In-memory storage is only used by unit tests and offline demo runs.
# CREATE DATABASE torob_tickets;
# $env:DATABASE_URL="postgresql://postgres:PASS@localhost:5432/torob_tickets?schema=public"
# npm run db:generate ; npm run db:push ; npm run db:seed
# `TOROB_DB_MODE=off` forces offline mode even when DATABASE_URL is set (useful in tests).
# DATABASE_URL="postgresql://postgres:PASS@localhost:5432/torob_tickets?schema=public"

# ——— Sepehr360 (HTML, no credentials) ———
# Enabled by default. One request per user search, robots.txt honoured, CAPTCHA never
# bypassed. Set to false to disable the connector entirely.
# ENABLE_SEPEHR360=true
# The page prints prices in "تومان"; only override with evidence (rial prices are ÷10).
# SEPEHR360_UNIT=toman
# Test hook: point the connector at a local mirror/fixture server.
# SEPEHR360_BASE_URL=http://127.0.0.1:4000

# ——— Amadeus Self-Service (official API, needs keys) ———
# Register at https://developers.amadeus.com — the test environment is free and returns
# CACHED SAMPLE DATA. Test data is always labelled in the UI and never presented as a
# live price. Production credentials are separate variables on purpose: no fallback.
# AMADEUS_ENV=test
# AMADEUS_CLIENT_ID=...
# AMADEUS_CLIENT_SECRET=...
# AMADEUS_CLIENT_ID_PRODUCTION=...
# AMADEUS_CLIENT_SECRET_PRODUCTION=...

# Manual verification (never run in CI — they hit real services):
#   npm run provider:check sepehr360
#   npm run search:live THR MHD 2026-11-20
#   npm run db:doctor ; npm run db:history -- THR MHD 2026-11-20

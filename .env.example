# Copy to .env locally. Replace placeholders only in the ignored local file.
# Never commit secrets, source responses, or local crawl data.

# Optional LLM configuration
# OPENAI_API_KEY=replace-me
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=replace-me

# Optional PostgreSQL configuration
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/torob_tickets?schema=public
# TOROB_DB_MODE=off

# Explicit crawler configuration (operator-run only)
# CRAWLER_ENABLED=1
# CRAWLER_ROUTES=THR-MHD
# CRAWLER_SOURCES=safarmarket
# CRAWLER_INTERVAL_MINUTES=60
# CRAWLER_HORIZON_DAYS=1
# CRAWLER_REQUEST_DELAY_MS=10000

# Optional Basisfly configuration variable names
# BASISFLY_REQUEST_TEMPLATE=
# BASISFLY_LOCATION_IDS=
# SECRET_TOROB=

# Optional trusted proxy configuration
# TRUST_PROXY=1
